# Mantiene stabile il codice e conserva i byte originali dei dati sperimentali.
* text=auto eol=lf
*.csv -text -whitespace
*.jsonl -text -whitespace
*.json -text
*.npz -text
*.pdf -text
*.png -text

# Nello ZIP l'unico file Markdown è il README principale.
*.md export-ignore
*.MD export-ignore
/README.md -export-ignore

# Materiale di sviluppo escluso dalla consegna al professore.
/tests export-ignore
/tests/** export-ignore
/docs export-ignore
/docs/** export-ignore
/THIRD_PARTY_NOTICES* export-ignore

# I grafici della consegna sono immagini, senza PDF o sorgenti di impaginazione.
*.pdf export-ignore
*.PDF export-ignore
*.tex export-ignore
